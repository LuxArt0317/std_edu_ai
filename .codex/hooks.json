{
  "description": "Keep Issue #56 active until Stitch designs are validated, implemented, and production verified.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/stitch_ui_completion_guard.mjs\" session",
            "statusMessage": "Loading Stitch UI/UX completion contract",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/stitch_ui_completion_guard.mjs\" stop",
            "statusMessage": "Checking Stitch UI/UX completion evidence",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
