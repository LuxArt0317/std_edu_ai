{
  "description": "Keep Issue #58 active until every CRM page has validated Stitch evidence and production verification.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/stitch_all_pages_guard.mjs\" session",
            "statusMessage": "Loading all-page Stitch completion contract",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/stitch_all_pages_guard.mjs\" stop",
            "statusMessage": "Checking all-page Stitch completion evidence",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
