# Large public documents are materialized from the pinned manifest at build time.
/public/school-assets/*.pdf
/public/school-assets/*.doc
/public/school-assets/*.docx
/public/school-assets/*.xls
/public/school-assets/*.xlsx
/public/school-assets/*.ppt
/public/school-assets/*.pptx
/public/school-assets/*.zip
/public/school-assets/*.rar

# Temporary public-document packaging workspace.
/vendor/.school-documents-*

# Unpublished captured media remain local until explicitly manifest-owned.
/public/school-assets/*.mp4
/public/school-assets/*.mp3
/public/school-assets/*.odt

# Private local assistant evaluation answers and run history
.evaluation-lab/

# Build-derived assistant module; the TypeScript source remains authoritative.
/server/affairsAssistantRuntime.js
/server/affairsAssistantRuntime.js.tmp
