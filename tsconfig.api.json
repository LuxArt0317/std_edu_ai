{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "api",
    "server",
    "tests/api",
    "src/utils/async.ts",
    "src/services/housing.ts",
    "src/features/school/onboarding.ts",
    "src/features/school/richLessonContent.ts",
    "src/features/school/schoolAgentLoop.ts",
    "src/features/school/types.ts",
    "src/features/public/mirror/paths.ts",
    "scripts/lib/download-school-asset.d.mts"
  ]
}
