{
  "name": "stu-edu-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run verify:build",
    "lint": "oxlint",
    "test": "node scripts/verify-needed-catalog.mjs && node scripts/verify-stitch-ui.mjs && node scripts/verify-stitch-all-pages.mjs && node --experimental-strip-types --test tests/api/*.test.ts",
    "verify:needed": "node scripts/verify-needed-catalog.mjs",
    "verify:stitch-ui": "node scripts/verify-stitch-ui.mjs",
    "verify:stitch-all-pages": "node scripts/verify-stitch-all-pages.mjs",
    "test:live-crm": "node tests/integration/crm-live.mjs",
    "test:live-school": "node tests/integration/school-live.mjs",
    "test:live-academic-operations": "node tests/integration/academic-operations-live.mjs",
    "test:live-lms": "node tests/integration/lms-live.mjs",
    "test:live-roles": "node tests/integration/role-portals-live.mjs",
    "test:live-needed-roles": "node tests/integration/needed-role-evidence-live.mjs",
    "test:live-accounts": "node tests/integration/all-role-accounts-live.mjs",
    "export:role-credentials": "node tests/integration/export-role-credentials.mjs",
    "test:live-onboarding": "node tests/integration/onboarding-live.mjs",
    "test:live-shell": "node tests/integration/deployment-shell-live.mjs",
    "verify:build": "node tests/integration/build-assets.mjs",
    "diagnose:production": "npm run test:live-shell",
    "test:live-ai": "node --experimental-strip-types tests/integration/ai-live.mjs",
    "test:live-nexus-agent": "node --experimental-strip-types tests/integration/nexus-agent-live.mjs",
    "test:live-account-lifecycle": "node tests/integration/account-lifecycle-live.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
