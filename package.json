{
  "name": "stu-edu-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run verify:build",
    "lint": "oxlint",
    "test": "node scripts/verify-needed-catalog.mjs && node scripts/verify-needed-v3.mjs && node scripts/verify-research-protocol.mjs && node scripts/verify-research-104.mjs && node scripts/verify-research-trace-evidence.mjs && node scripts/verify-stitch-ui.mjs && node scripts/verify-stitch-all-pages.mjs && node --experimental-strip-types --test tests/api/*.test.ts",
    "verify:needed": "node scripts/verify-needed-catalog.mjs",
    "verify:research-104": "node scripts/verify-research-104.mjs",
    "verify:research-protocol": "node scripts/verify-research-protocol.mjs",
    "verify:research-traces": "node scripts/verify-research-trace-evidence.mjs",
    "verify:stitch-ui": "node scripts/verify-stitch-ui.mjs",
    "verify:stitch-all-pages": "node scripts/verify-stitch-all-pages.mjs",
    "test:live-crm": "node tests/integration/crm-live.mjs",
    "test:live-admissions-pipeline": "node tests/integration/admissions-pipeline-live.mjs",
    "test:live-school": "node tests/integration/school-live.mjs",
    "test:live-academic-operations": "node tests/integration/academic-operations-live.mjs",
    "test:live-lms": "node tests/integration/lms-live.mjs",
    "test:live-roles": "node tests/integration/role-portals-live.mjs",
    "test:live-needed-roles": "node tests/integration/needed-role-evidence-live.mjs",
    "test:live-accounts": "node tests/integration/all-role-accounts-live.mjs",
    "export:role-credentials": "node tests/integration/export-role-credentials.mjs",
    "test:live-onboarding": "node tests/integration/onboarding-live.mjs",
    "test:live-shell": "node tests/integration/deployment-shell-live.mjs",
    "verify:build": "node tests/integration/build-assets.mjs",
    "diagnose:production": "npm run test:live-shell",
    "test:live-ai": "node --experimental-strip-types tests/integration/ai-live.mjs",
    "test:live-nexus-agent": "node --experimental-strip-types tests/integration/nexus-agent-live.mjs",
    "test:live-curriculum": "node tests/integration/curriculum-live.mjs",
    "test:live-relationships": "node tests/integration/issue103-live.mjs",
    "test:live-research-foundation": "node tests/integration/research-foundation-live.mjs",
    "test:live-knowledge-ingestion": "node --experimental-strip-types tests/integration/knowledge-ingestion-live.mjs",
    "test:live-ingestion-telemetry": "node tests/integration/ingestion-telemetry-live.mjs",
    "test:live-ingestion-api": "node tests/integration/ingestion-api-live.mjs",
    "test:live-knowledge-acquisition": "node tests/integration/knowledge-acquisition-live.mjs",
    "test:live-campus-routing": "node --experimental-strip-types tests/integration/campus-routing-live.mjs",
    "test:live-research-study": "node --experimental-strip-types tests/integration/research-study-runner-live.mjs",
    "test:live-workload": "node tests/integration/administrative-workload-live.mjs",
    "test:live-issue90": "node --experimental-strip-types tests/integration/issue90-live.mjs",
    "test:live-issue101": "node --experimental-strip-types tests/integration/issue101-live.mjs",
    "test:live-account-lifecycle": "node tests/integration/account-lifecycle-live.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "@thednp/dommatrix": "3.0.4",
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "cheerio": "1.2.0",
    "file-type": "22.0.1",
    "pdfjs-dist": "6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
