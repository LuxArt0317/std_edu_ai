# Browser-safe values for the client project; never put service keys here.
VITE_SUPABASE_URL=https://xiftudmvxphxcjtmfmib.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional server-only AI configuration. Supply actual values outside Git.
OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_PUBLIC_MODEL=
# OPENAI_VISION_MODEL=
# OPENAI_EMBEDDING_MODEL=
# SAFETY_HASH_SALT=

# Local media tooling only: put the actual value in ignored .env.elevenlabs.local (0600).
# Never prefix with VITE_ or add it to browser configuration.
# ELEVENLABS_API_KEY=

# Optional server-only announcement mail transport. Configure all three in the
# client production environment before enabling a delivery schedule.
# CRON_SECRET=
# ANNOUNCEMENT_EMAIL_RESEND_KEY=
# ANNOUNCEMENT_EMAIL_FROM=

# Optional server-only model selection for local/manual review.
# OPENAI_MODEL=gpt-6.2-astra
# OPENAI_PUBLIC_MODEL=gpt-6.2-astra
# OPENAI_VERIFICATION_MODEL=gpt-6.2-astra
# Optional independent source-audit effort: low, medium, high. Unset preserves request/default effort.
# OPENAI_VERIFICATION_REASONING_EFFORT=low
# OPENAI_VERIFICATION_ESCALATION_MODEL=gpt-6.2-astra
# OPENAI_SEARCH_MODEL=gpt-6.2-astra
# OPENAI_REASONING_EFFORT=medium

# Automatically discovered application APIs in the signed-in chatbot.
# Enable locally after running compile:application-apis; no cloud deployment is implied.
# ASSISTANT_API_TOOLS_ENABLED=true
# Local-only durable action reviews: absolute owner-only directory, never /tmp.
# ASSISTANT_API_ACTION_STORE=/absolute/private/path/api-tool-actions
# Hosted action reviews use the owner-scoped assistant_api_* migration/RPCs.
# Optional dedicated signing key (at least 24 characters); otherwise the existing
# server-only provider key is domain-separated for review/receipt signatures.
# ASSISTANT_API_SIGNING_SECRET=

# Local-first unified website/API discovery; enable both flags together.
# ASSISTANT_DISCOVERY_ENABLED=true
# VITE_ASSISTANT_UNIFIED_DISCOVERY=true
# ASSISTANT_EMBEDDINGS_ENABLED=true
# OPENAI_DISCOVERY_PLANNER_MODEL=gpt-6.1-terra

# Durable hosted conversation memory: apply the assistant_memory migration first.
# Server secret SUPABASE_SERVICE_ROLE_KEY must never use a VITE_ prefix.
# ASSISTANT_MEMORY_ENABLED=true
# Daily database job: select public.assistant_memory_purge_expired();
