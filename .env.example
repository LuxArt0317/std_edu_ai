# CRON_SECRET=
# ANNOUNCEMENT_EMAIL_RESEND_KEY=
# ANNOUNCEMENT_EMAIL_FROM=

# Optional server-only model selection for local/manual review.
# OPENAI_MODEL=gpt-6.2-astra
# OPENAI_PUBLIC_MODEL=gpt-6.2-astra
# OPENAI_VERIFICATION_MODEL=gpt-6.2-astra
